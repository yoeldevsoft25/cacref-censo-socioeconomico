# Copy to .env and fill in real values

# Server
PORT=7842
NODE_ENV=production

# Admin users — generate hashes with: npx tsx scripts/hash-password.ts <password>
ADMIN_PASS_HASH=$2b$10$fETDCGLMEEKDNvqCikPtIejMQY90zD3nrAJTEq2Aot5tRbxebqSje
PRES_PASS_HASH=$2b$10$fETDCGLMEEKDNvqCikPtIejMQY90zD3nrAJTEq2Aot5tRbxebqSje
VOCAL_PASS_HASH=$2b$10$fETDCGLMEEKDNvqCikPtIejMQY90zD3nrAJTEq2Aot5tRbxebqSje
CAPT_PASS_HASH=$2b$10$fETDCGLMEEKDNvqCikPtIejMQY90zD3nrAJTEq2Aot5tRbxebqSje

# Session signing — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=replace-with-48-bytes-base64url

# Database (Turso / libSQL)
# Leave TURSO_* empty to use local SQLite (census.db file)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Email notifications (Resend)
# Leave empty to use mock mode (emails logged to console)
RESEND_API_KEY=
SENDER_EMAIL=noreply@cacref.example.com
SENDER_NAME=CACREF Censo

# App
APP_BASE_URL=https://your-domain.com
