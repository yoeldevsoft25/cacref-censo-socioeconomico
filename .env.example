# Copy to .env and fill in real values
# All ADMIN_*_PASS_HASH and ADMIN_SESSION_SECRET are REQUIRED at boot.
# The server refuses to start if any are missing or invalid.

# Server
PORT=7842
NODE_ENV=production

# Admin users — generate hashes with: npx tsx scripts/hash-password.ts <password>
ADMIN_PASS_HASH=
PRES_PASS_HASH=
VOCAL_PASS_HASH=
CAPT_PASS_HASH=

# Session signing — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# REQUIRED — server refuses to start if missing or shorter than 32 chars.
ADMIN_SESSION_SECRET=

# Database (Turso / libSQL)
# Leave TURSO_* empty to use local SQLite (census.db file)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Email notifications (Resend)
# Create account at https://resend.com — free tier: 100 emails/day, 3000/month
# 1) Verify domain futpvcacref.com in Resend dashboard (adds DKIM + SPF records)
# 2) Generate an API key restricted to "Sending access" only
# 3) Paste below. Leave RESEND_API_KEY empty to use mock mode (logs to console)
RESEND_API_KEY=
SENDER_EMAIL=noreply@futpvcacref.com
SENDER_NAME=CACREF Censo

# Public URL of the deployed app (used in email links)
APP_BASE_URL=https://futpvcacref.com
